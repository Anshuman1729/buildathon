# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: path to the SQLite database file (defaults to ./data/second-brain.db)
# DATABASE_PATH=./data/second-brain.db
