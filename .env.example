# Groq API key — get a free one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the "stale" threshold in days (defaults to 14). Useful
# for testing/demos without waiting 14 real days — e.g. STALE_DAYS=0.001
# (~1.5 minutes) to see staleness fire on data you just imported. Set back
# to 14 (or unset) for real use.
# STALE_DAYS=14

# Postgres connection string.
# On Vercel: attach Vercel Postgres storage to the project and it injects
# POSTGRES_URL automatically — no need to set this yourself.
# Locally / other providers (Neon, Supabase, Railway, local Postgres): set
# DATABASE_URL to a standard postgres:// connection string.
DATABASE_URL=postgres://user:password@localhost:5432/second_brain
